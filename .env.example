# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cheetcode"

# Secret used to sign login tokens. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Optional: comma-separated list of allowed frontend origins (default: allow all)
# CORS_ORIGIN="https://your-frontend.vercel.app,http://localhost:5173"

# Optional: port to listen on (Render and most hosts set this for you)
# PORT=3000
