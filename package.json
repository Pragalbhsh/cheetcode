{
  "name": "cheetcode",
  "version": "2.0.0",
  "description": "Cheatcode API: spaced-repetition revision for the NeetCode 150",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "start:server": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pragalbhsh/cheetcode.git"
  },
  "keywords": [
    "dsa",
    "leetcode",
    "neetcode",
    "spaced-repetition",
    "sm-2"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Pragalbhsh/cheetcode/issues"
  },
  "homepage": "https://github.com/Pragalbhsh/cheetcode#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
