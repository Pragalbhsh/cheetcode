generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Topic {
  id         String   @id @default(uuid())
  name       String   @unique
  orderIndex Int      @unique
  createdAt  DateTime @default(now())

  problems Problem[]
  users    User[]    @relation("CurrentTopic")
}

model Problem {
  id           String     @id @default(uuid())
  title        String
  topicId      String
  topic        Topic      @relation(fields: [topicId], references: [id])
  difficulty   Difficulty
  platform     Platform
  leetcodeSlug String?
  gfgSlug      String?
  sheet        Sheet
  orderIndex   Int
  /// YouTube id of the NeetCode explanation video
  videoId      String?
  /// Free alternative (e.g. LintCode) for LeetCode-premium problems
  freeLink     String?
  premium      Boolean    @default(false)
  blind75      Boolean    @default(false)

  userProgress     UserProgress[]
  revisionSchedule RevisionSchedule[]
  activities       Activity[]

  @@unique([title, topicId])
  @@index([topicId, orderIndex])
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String
  leetcodeUsername String?
  gfgUsername      String?
  currentTopicId   String?
  currentTopic     Topic?    @relation("CurrentTopic", fields: [currentTopicId], references: [id])
  streakProtector  Boolean   @default(false)
  lastSyncedAt     DateTime?
  /// Today's streak-protector pick, kept stable for the whole day
  streakProblemId  String?
  streakProblemDay String?
  createdAt        DateTime  @default(now())

  userProgress     UserProgress[]
  revisionSchedule RevisionSchedule[]
  activities       Activity[]
}

model UserProgress {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId    String
  problem      Problem     @relation(fields: [problemId], references: [id])
  status       SolveStatus
  solvedAt     DateTime?
  autoImported Boolean     @default(false)
  /// The user's own one-line insight / approach, shown when revising
  notes        String?

  @@unique([userId, problemId])
}

model RevisionSchedule {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id])
  nextReviewDate DateTime @default(now())
  intervalDays   Int      @default(1)
  easeFactor     Float    @default(2.5)
  repetitions    Int      @default(0)
  lastRating     Rating?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, problemId])
  @@index([userId, nextReviewDate])
}

/// One row per thing the user did (solved / reviewed / practised).
/// Powers streaks, the activity heatmap and "today" counters.
model Activity {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String?
  problem   Problem?     @relation(fields: [problemId], references: [id], onDelete: SetNull)
  type      ActivityType
  rating    Rating?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Platform {
  LEETCODE
  GFG
  BOTH
}

enum Sheet {
  STRIVER
  NEETCODE_150
  BOTH
}

enum SolveStatus {
  SOLVED
  ATTEMPTED
  SKIPPED
}

enum Rating {
  FORGOT
  HARD
  OKAY
  EASY
}

enum ActivityType {
  SOLVED
  REVIEWED
  PRACTICED
}
